<section id="TechCollection-{{ section.id }}" class="tech-collection">
  <div class="tech-heading"><div><p class="tech-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div></div>
  {% assign selected_collection = section.settings.collection %}
  {% if selected_collection != blank %}
    <div class="tech-grid">
    {% for product in selected_collection.products limit: section.settings.product_limit %}
      {% assign form_id = 'TechProduct-' | append: section.id | append: '-' | append: product.id %}
      <article class="tech-card">
        <a href="{{ product.url }}" class="tech-image">
        {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '300, 500, 700', sizes: '(max-width: 700px) 100vw, 33vw', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}
        </a>
        <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><p class="tech-price">{{ product.price_min | money }}{% if product.price_varies %} +{% endif %}</p>
        {% form 'product', product, id: form_id %}
          {% if product.available %}
            <label for="Variant-{{ section.id }}-{{ product.id }}">Choose option</label>
            <select name="id" id="Variant-{{ section.id }}-{{ product.id }}">
            {% for variant in product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}>{{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}
            </select><input type="hidden" name="quantity" value="1"><button type="submit">Add to cart</button>
          {% else %}<button type="button" disabled>Sold out</button>{% endif %}
        {% endform %}
      </article>
    {% else %}<p>No products in this collection yet.</p>{% endfor %}
    </div><a class="tech-more" href="{{ selected_collection.url }}">Browse the full collection →</a>
  {% else %}<p>Select a collection in the theme editor to display products.</p>{% endif %}
</section>
{% style %}
#TechCollection-{{ section.id }}{max-width:1200px;margin:auto;padding:48px 24px;color:{{ section.settings.text_color }};background:{{ section.settings.background }};border-radius:20px}
#TechCollection-{{ section.id }} .tech-eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase}
#TechCollection-{{ section.id }} h2{font-size:clamp(28px,4vw,44px);letter-spacing:-.04em;margin:10px 0}
#TechCollection-{{ section.id }} .tech-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:32px 0}
#TechCollection-{{ section.id }} .tech-card{border:1px solid currentColor;border-radius:12px;padding:18px}
#TechCollection-{{ section.id }} .tech-image{display:block;aspect-ratio:4/3;background:#ffffff80;border-radius:8px;overflow:hidden}
#TechCollection-{{ section.id }} .tech-image img,#TechCollection-{{ section.id }} .tech-image svg{width:100%;height:100%;object-fit:contain}
#TechCollection-{{ section.id }} a{color:inherit}#TechCollection-{{ section.id }} label{display:block;font-size:12px}
#TechCollection-{{ section.id }} select{width:100%;padding:10px;border:1px solid #bbb;border-radius:6px;margin:8px 0;background:white;color:#182539}
#TechCollection-{{ section.id }} button{width:100%;border:0;border-radius:6px;padding:13px;background:{{ section.settings.accent }};color:{{ section.settings.button_text }};cursor:pointer}
#TechCollection-{{ section.id }} button:disabled{opacity:.5;cursor:default}#TechCollection-{{ section.id }} :focus-visible{outline:3px solid currentColor;outline-offset:3px}
@media(max-width:700px){#TechCollection-{{ section.id }} .tech-grid{grid-template-columns:1fr}}
{% endstyle %}
{% schema %}
{
  "name": "Tech collection",
  "tag": "section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Built for your workflow"},
    {"type":"text","id":"heading","label":"Heading","default":"Tools for a better desk."},
    {"type":"text","id":"description","label":"Description","default":"Thoughtful essentials for your next setup."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"product_limit","label":"Product limit","min":3,"max":12,"step":3,"default":6},
    {"type":"color","id":"background","label":"Background","default":"#f3f5fa"},
    {"type":"color","id":"text_color","label":"Text","default":"#182539"},
    {"type":"color","id":"accent","label":"Button background","default":"#364bd7"},
    {"type":"color","id":"button_text","label":"Button text","default":"#ffffff"}
  ],
  "presets": [{"name":"Tech collection"}]
}
{% endschema %}
